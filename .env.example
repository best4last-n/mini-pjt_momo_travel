# 이 파일은 키 이름만 적어 두는 견본입니다 (깃에 올라감, 실제 값은 넣지 마세요)
# 사용법: 이 파일을 .env로 복사한 뒤 값을 채웁니다.

# ---- 필수 ----
# 한국관광공사 TourAPI (공공데이터포털) — 데이터 수집·실시간 장소 편입
TOURAPI_SERVICE_KEY=
# AWS Bedrock — Claude Sonnet 4.5(생성) · Sonnet 4.6(평가 Judge) · Titan Embeddings v2(벡터 색인)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ---- 선택 (없어도 동작) ----
# LangSmith 트레이스
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=momo-travel
# 브이월드 — 지도 타일·주소/장소 검색(없으면 OpenStreetMap만)
VWORLD_API_KEY=
# 국가교통정보센터(ITS) — 실시간 소통·예측·돌발·CCTV(없으면 요일·시간대 평균 혼잡 보정만)
ITS_API_KEY=
# 카카오·네이버 장소 검색(없으면 관광공사·브이월드·OSM만)
KAKAO_REST_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 생성 모델 바꾸기(기본 us.anthropic.claude-sonnet-4-5-20250929-v1:0)
# MOMO_GEN_MODEL=
# 오늘 날짜 고정(평가 재현용, 예: 2026-11-25 — evaluation/run_eval.py는 자동으로 고정)
# MOMO_TODAY=
